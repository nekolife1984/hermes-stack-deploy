# 会社向け新規環境 — 環境変数
# cp .env.example .env して編集

# ── Hermes Agent ゲートウェイ ─────────────────────────────
# モデルのAPIキー。OpenAI互換バックエンドなら HERMES_URL / HERMES_MODEL で指定
ANTHROPIC_API_KEY=

# HermesのHTTP APIサーバ(ポート8642)を有効化(Studioと接続するために必須)
API_SERVER_ENABLED=true

# Hermes Agent 取得元とバージョン
# デフォルトは NousResearch(本家)。Hermes Studioの拡張機能(承認/メモリグラフ等)が
# 出ない場合は outsourc-e フォークに切り替える(Studioはフォーク前提でテストされている)
HERMES_AGENT_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_AGENT_VERSION=main        # 例: 0.18.0 でピン止め可

# ── Hermes Studio (Web UI) ────────────────────────────────
HERMES_API_URL=http://hermes-agent:8642   # compose内DNS。変更不要
HERMES_API_TOKEN=your-bearer-token        # エージェントが認証を要求する場合のみ
PORT=3000

# ── Redisセッション永続化(任意) ──────────────────────────
# 空のままならファイルストアにフォールバック
REDIS_URL=

# ── Vikunja ──────────────────────────────────────────────
# Vikunja APIトークン(ログイン用JWTではない。期限切れしない長期トークン)
# 取得: Vikunja UI → 設定 → APIトークン → 新規作成
VIKUNJA_API_TOKEN=your-vikunja-api-token
VIKUNJA_URL=http://vikunja:3456/api/v1   # compose内DNS。外部Vikunjaを使う場合は http://host.docker.internal:3456/api/v1 等