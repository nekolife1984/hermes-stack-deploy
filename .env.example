# 会社向け新規環境 — 環境変数
# cp .env.example .env して編集
# 必須(サービス間認証): API_SERVER_KEY / VIKUNJA_SERVICE_SECRET(未設定だと docker compose up が失敗)
# ── モデルプロバイダは GitHub Copilot を使用(下参照) ──

# ── モデルプロバイダ: GitHub Copilot ───────────────────────
# Copilotサブスクリプションで動かすので APIキー(ANTHROPIC等)は不要。
# 認証の優先順位: COPILOT_GITHUB_TOKEN → GH_TOKEN → GITHUB_TOKEN → gh auth token
# 対応トークン: gho_(OAuth) / github_pat_(Fine-grained, "Copilot Requests"権限) / ghu_。
#   ※ classic PAT(ghp_)はCopilot APIで使えない。無い場合はコンテナ内で
#     `docker compose exec hermes-agent hermes model` → GitHub Copilot → OAuthデバイスコードで発行。
COPILOT_GITHUB_TOKEN=
# 上と合わせて agent の config.yaml(model.provider=copilot, model.default=gpt-5.4 等)を設定する:
#   docker compose exec hermes-agent hermes model   # または hermes config set model.provider copilot

# ── Hermes Agent ゲートウェイ ─────────────────────────────
# モデルAPIキーは Copilot を使うので基本不要(空のまま)。非Copilotバックエンド/フォールバックのみ指定:
ANTHROPIC_API_KEY=

# Hermes HTTP APIサーバ(ポート8642)のBearer認証キー。Studioの HERMES_API_TOKEN と同値にすること
# 生成: openssl rand -hex 32
API_SERVER_KEY=

# Hermes Agent 取得元とバージョン(再現性のためリリースタグでピン止め推奨)
HERMES_AGENT_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_AGENT_VERSION=main        # 例: 0.18.0 でピン止め可

# ── Hermes Studio (Web UI) ────────────────────────────────
# エージェントの API_SERVER_KEY と同値を必ず設定する(Studio→Agentの認証)
HERMES_API_TOKEN=
# Studioのソース取得元とバージョン(リリースタグでピン止め推奨)
STUDIO_REPO=https://github.com/JPeetz/Hermes-Studio.git
STUDIO_VERSION=v1.18.1

# ── Redisセッション永続化(任意) ──────────────────────────
# 空のままならファイルストアにフォールバック。設定時は redis profile 起動必須(docker compose --profile redis up)
REDIS_URL=
REDIS_PASSWORD=

# ── Vikunja ──────────────────────────────────────────────
# VikunjaのJWT署名秘密(必須)。生成: openssl rand -base64 48
VIKUNJA_SERVICE_SECRET=
# 外部へ公開する場合の実URL(TLSリバプロ等)
VIKUNJA_PUBLICURL=http://localhost:3456
# Vikunja APIトークン(ログイン用JWTではない、期限切れしない長期トークン)
# 取得: Vikunja UI → 設定 → APIトークン → 新規作成(権限はプロジェクト・タスクの read/create/update)
VIKUNJA_API_TOKEN=
VIKUNJA_URL=http://vikunja:3456/api/v1